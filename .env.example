# Application
APP_ENV=development
APP_DEBUG=true
APP_LOG_LEVEL=INFO

# MongoDB (Use mongomock://localhost for no-setup local testing, or a real MongoDB URL)
MONGODB_URL=mongomock://localhost
MONGODB_DB_NAME=ask_my_docs

# Qdrant (Vector Database) (Use 'local' for local file storage, or http:// URL)
QDRANT_URL=local
QDRANT_API_KEY=

# Google API Key (embeddings — free at https://aistudio.google.com/apikey)
GOOGLE_API_KEY=

# Google OAuth (get from https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=

# JWT Authentication
JWT_SECRET_KEY=change-me-in-production-use-a-real-secret

# Razorpay (get from https://dashboard.razorpay.com/app/keys)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_CURRENCY=INR

# CORS
CORS_ORIGINS=http://localhost:5173

# Frontend
VITE_API_URL=http://localhost:8000
VITE_GOOGLE_CLIENT_ID=
VITE_RAZORPAY_KEY_ID=

# LLM Generation (NVIDIA NIM — free at https://build.nvidia.com)
LLM_PROVIDER=nvidia
LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b
NVIDIA_API_KEY=

NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
